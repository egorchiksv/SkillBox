@charset "utf-8";

a:link { color: rgb(0, 53, 199); }

a:visited { color: rgb(84, 99, 140); }

h1 { color: rgb(199, 0, 54); }

div.producttitle { color: rgb(199, 0, 54); }

.section h1.title { color: rgb(199, 0, 54); }

h2, h3, h4, h5, h6 { color: rgb(199, 0, 54); }

.docnav.top li.home { color: rgb(199, 0, 54); }

table { border: 1px solid rgb(170, 170, 170); }

table th { background-color: rgb(153, 0, 0); }

table tr.even td { background-color: rgb(245, 245, 245); }

#title a { height: 54px; }

.term { color: rgb(199, 0, 54); }

.revhistory table th { color: rgb(199, 0, 54); }

.titlepage .edition { color: rgb(199, 0, 54); }

span.remark { background-color: rgb(255, 255, 0); }

div.url { margin-top: 0.5em; }

div.url + div.url { margin-top: 0px; }

div.sidebar { border: 2px solid rgb(170, 170, 170); margin-top: 10px; margi=
