#ss2 * { font-family: "Exo 2", sans-serif; font-size: 16px; line-height: 20=
px; color: rgb(1, 1, 1); text-align: left; }

#ss2 .tl { font-size: 20px; line-height: 28px; font-weight: 700; padding: 1=
9px 17px 0px 27px; }

