@charset "utf-8";

.tablesaw { width: 100%; max-width: 100%; empty-cells: show; border-collaps=
e: collapse; border: 0px; padding: 0px; }

.tablesaw * { box-sizing: border-box; }

.tablesaw th, .tablesaw td { padding: 0.5em 0.7em; }

.tablesaw thead tr:first-child th { padding-top: 0.9em; padding-bottom: 0.7=
em; }

.tablesaw-bar .btn { border: 1px solid rgb(204, 204, 204); border-radius: 0=
.25em; background: none; box-shadow: rgb(255, 255, 255) 0px 1px 0px; color:=
 rgb(74, 74, 74); cursor: pointer; display: inline-block; margin: 0px; padd=
ing: 0.5em 0.85em 0.4em; position: relative; text-align: center; text-decor=
ation: none; text-transform: capitalize; appearance: none; }

.tablesaw-bar a.btn { color: rgb(28, 149, 212); }

.tablesaw-bar .btn:hover { text-decoration: none; }

.tablesaw-bar .btn:active { background-color: rgb(221, 221, 221); }

@supports (box-shadow: none ) {
  .tablesaw-bar .btn:focus { background-color: rgb(255, 255, 255); outline:=
 none; }
  .tablesaw-bar .btn:focus { box-shadow: rgb(79, 174, 239) 0px 0px 0.35em !=
important; }
}

.tablesaw-bar .btn-select select { background: none; border: none; display:=
 inline-block; position: absolute; left: 0px; top: 0px; margin: 0px; width:=
 100%; height: 100%; z-index: 2; min-height: 1em; opacity: 0; color: transp=
arent; }

.tablesaw-bar .btn select option { background: rgb(255, 255, 255); color: r=
gb(0, 0, 0); font-family: sans-serif; }

.tablesaw-bar .btn { display: inline-block; width: auto; height: auto; posi=
tion: relative; top: 0px; }

.tablesaw-bar .btn.btn-small { font-size: 1.0625em; line-height: 19px; padd=
ing: 0.3em 1em; }

