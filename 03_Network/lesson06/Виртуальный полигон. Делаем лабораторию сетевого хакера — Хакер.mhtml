@charset "utf-8";

#sticker { width: 240px; float: right; margin-right: -260px; }

.xakep-ads { display: none; text-align: center; font-size: 20px; margin: 25=
px auto; }

body.logged-in.subscriber .xakep-ads { display: none !important; }

.bdaia-blocks .xakep-ads { margin: 0px auto 60px; }

#warp > .xakep-ads { margin-top: 0px; }

#content > .xakep-ads, #content footer .xakep-ads { margin: 0px auto 40px; =
}

#respond > .xakep-ads { margin-top: 30px; }

#sticker .xakep-ads { margin: 0px; }

@media screen and (min-width: 986px) and (max-width: 1180px) {
  #leaderboard0-desktop { display: none !important; }
}

@media screen and (min-width: 830px) and (max-width: 985px) {
  #mpu0-desktop, #mpu1-desktop { display: none !important; }
}

@media screen and (min-width: 768px) and (max-width: 829px) {
  #mpu0-desktop, #mpu1-desktop { display: none !important; }
}

@media screen and (min-width: 521px) and (max-width: 767px) {
  #leaderboard0-desktop { display: none !important; }
  #mpu0-desktop, #mpu1-desktop { display: none !important; }
}

@media screen and (max-width: 520px) {
  #leaderboard0-desktop { display: none !important; }
}
